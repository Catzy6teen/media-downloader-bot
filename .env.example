# ============================================================
# Telegram Torrent Creator Bot  -  Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Telegram ──────────────────────────────────────────────
# Obtain from @BotFather on Telegram
BOT_TOKEN=1234567890:AAExampleBotTokenReplaceMe

# Your numeric Telegram user ID (use @userinfobot to find it)
OWNER_ID=123456789

# ── Web upload auth ───────────────────────────────────────
# Random secret ≥ 16 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_KEY=replace-this-with-a-long-random-secret

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Storage (absolute paths on VPS) ───────────────────────
# Source uploads are stored here temporarily (deleted after delivery)
UPLOAD_DIR=/opt/tg-torrent-bot/data/uploads
# Generated .torrent files are kept here permanently
TORRENT_DIR=/opt/tg-torrent-bot/data/torrents

# ── Torrent creation ──────────────────────────────────────
# Comma-separated list of tracker announce URLs
# Replace with your own tracker or leave the public defaults
TRACKER_URLS=["udp://tracker.opentrackr.org:1337/announce","udp://open.tracker.cl:1337/announce"]
# Piece size in KiB (0 = mktorrent auto-selects; good for large files)
TORRENT_PIECE_SIZE_KIB=0
# Path to mktorrent binary (usually just "mktorrent" if on PATH)
MKTORRENT_BIN=mktorrent

# ── Upload limits ─────────────────────────────────────────
# Maximum upload size in bytes (default: 60 GiB)
MAX_UPLOAD_BYTES=64424509440
# Chunk size for streaming reads in bytes (default: 1 MiB)
UPLOAD_CHUNK_SIZE=1048576

# ── Concurrency ───────────────────────────────────────────
# Max simultaneous torrent-creation jobs
MAX_CONCURRENT_JOBS=2
# Max upload requests per IP per minute
RATE_LIMIT_RPM=10

# ── Misc ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "development" to enable /docs and verbose access logs
ENV=production
