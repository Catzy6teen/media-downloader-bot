[Unit]
Description=Telegram Torrent Creator Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torrentbot
Group=torrentbot
WorkingDirectory=/opt/tg-torrent-bot
EnvironmentFile=/opt/tg-torrent-bot/.env
ExecStart=/opt/tg-torrent-bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# ── Resource limits ──────────────────────────────────────────────────────────
# Prevent a runaway job from eating all disk
#LimitFSIZE=70G
# Prevent memory overrun (adjust to your VPS RAM)
#MemoryMax=4G

# ── Security hardening ───────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tg-torrent-bot/data

# ── Logging ──────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tg-torrent-bot

[Install]
WantedBy=multi-user.target
